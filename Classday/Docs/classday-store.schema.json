{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classday.local/schema/classday-store-1.json",
  "title": "ClassdayStore",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "origin", "semester", "courses"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "origin": { "enum": ["demo", "user"] },
    "semester": { "$ref": "#/$defs/semester" },
    "courses": {
      "type": "array",
      "items": { "$ref": "#/$defs/course" }
    },
    "weekRules": { "type": "array", "items": { "$ref": "#/$defs/weekRule" } },
    "overrides": { "type": "array", "items": { "$ref": "#/$defs/override" } },
    "exams": { "type": "array", "items": { "$ref": "#/$defs/exam" } },
    "homework": { "type": "array", "items": { "$ref": "#/$defs/homework" } },
    "personalEvents": { "type": "array", "items": { "$ref": "#/$defs/personalEvent" } },
    "rooms": { "type": "array", "items": { "$ref": "#/$defs/roomPin" } },
    "library": { "type": "array", "items": { "$ref": "#/$defs/storedTimetable" } },
    "activeTimetableID": { "type": "string" },
    "appearance": { "$ref": "#/$defs/appearance" },
    "subscribedICSURL": { "type": "string" }
  },
  "$defs": {
    "semester": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "shortName", "startDate", "totalWeeks", "periods", "defaultReminderMinutes"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "shortName": { "type": "string", "minLength": 1 },
        "startDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "totalWeeks": { "type": "integer", "minimum": 1, "maximum": 30 },
        "defaultReminderMinutes": { "type": "integer", "minimum": 0, "maximum": 180 },
        "periods": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/period" }
        },
        "holidays": { "type": "array", "items": { "$ref": "#/$defs/holiday" } },
        "cancellations": { "type": "array", "items": { "$ref": "#/$defs/cancellation" } }
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "start", "end"],
      "properties": {
        "index": { "type": "integer", "minimum": 1 },
        "start": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
        "end": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" }
      }
    },
    "holiday": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "startDate", "endDate"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "startDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "endDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "cancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "date", "courseName", "scope"],
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "courseID": { "type": ["string", "null"] },
        "courseName": { "type": "string" },
        "scope": { "enum": ["day", "all", "am", "pm"] },
        "reason": { "type": "string" }
      }
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "teacher", "location", "department", "note", "colorID", "kind", "weeks", "meetings"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "teacher": { "type": "string" },
        "location": { "type": "string" },
        "department": { "type": "string" },
        "note": { "type": "string" },
        "colorID": { "type": "string" },
        "kind": { "type": "string" },
        "weeks": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1 },
        "meetings": { "type": "array", "items": { "$ref": "#/$defs/meeting" }, "minItems": 1 },
        "reminderLeadMinutes": { "type": "integer", "minimum": 0, "maximum": 180 },
        "credits": { "type": "number", "minimum": 0 },
        "grade": { "type": "number" },
        "gradeScheme": { "$ref": "#/$defs/gradeScheme" }
      }
    },
    "meeting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "weekday", "startPeriod", "endPeriod"],
      "properties": {
        "id": { "type": "string" },
        "weekday": { "type": "integer", "minimum": 1, "maximum": 7 },
        "startPeriod": { "type": "integer", "minimum": 1 },
        "endPeriod": { "type": "integer", "minimum": 1 }
      }
    },
    "gradeScheme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scale": { "type": "number", "exclusiveMinimum": 0 },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" }
            }
          }
        },
        "scores": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "branches": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["componentID", "weight"],
              "properties": {
                "componentID": { "type": "string" },
                "weight": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          }
        }
      }
    },
    "weekRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["meetingID", "parity"],
      "properties": {
        "meetingID": { "type": "string" },
        "parity": { "enum": ["any", "odd", "even"] }
      }
    },
    "override": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "courseID", "meetingID", "week", "kind"],
      "properties": {
        "id": { "type": "string" },
        "courseID": { "type": "string" },
        "meetingID": { "type": "string" },
        "week": { "type": "integer", "minimum": 1 },
        "kind": { "enum": ["cancelled", "moved", "delayed"] },
        "weekday": { "type": "integer", "minimum": 1, "maximum": 7 },
        "startPeriod": { "type": "integer", "minimum": 1 },
        "endPeriod": { "type": "integer", "minimum": 1 },
        "delayMinutes": { "type": "integer" }
      }
    },
    "exam": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "courseName", "location", "startISO", "endISO"],
      "properties": {
        "id": { "type": "string" },
        "courseName": { "type": "string" },
        "location": { "type": "string" },
        "startISO": { "type": "string", "minLength": 16 },
        "endISO": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "homework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "courseName", "title", "dueISO"],
      "properties": {
        "id": { "type": "string" },
        "courseName": { "type": "string" },
        "title": { "type": "string" },
        "dueISO": { "type": "string", "minLength": 16 },
        "done": { "type": "boolean" },
        "note": { "type": "string" }
      }
    },
    "personalEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "startISO", "endISO"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "note": { "type": "string" },
        "startISO": { "type": "string", "minLength": 16 },
        "endISO": { "type": "string" }
      }
    },
    "roomPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "query"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "latitude": { "type": ["number", "null"] },
        "longitude": { "type": ["number", "null"] },
        "query": { "type": "string" }
      }
    },
    "storedTimetable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "semester", "courses"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "semester": { "$ref": "#/$defs/semester" },
        "courses": { "type": "array", "items": { "$ref": "#/$defs/course" } },
        "weekRules": { "type": "array", "items": { "$ref": "#/$defs/weekRule" } },
        "overrides": { "type": "array", "items": { "$ref": "#/$defs/override" } },
        "exams": { "type": "array", "items": { "$ref": "#/$defs/exam" } },
        "homework": { "type": "array", "items": { "$ref": "#/$defs/homework" } },
        "rooms": { "type": "array", "items": { "$ref": "#/$defs/roomPin" } }
      }
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "themeID": { "type": "string" },
        "performance": { "enum": ["high", "balanced", "saver"] }
      }
    }
  }
}
