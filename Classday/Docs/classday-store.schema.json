{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://classday.local/schema/classday-store-1.json",
  "title": "ClassdayStore",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "origin", "semester", "courses"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "origin": { "enum": ["demo", "user"] },
    "semester": { "$ref": "#/$defs/semester" },
    "courses": {
      "type": "array",
      "items": { "$ref": "#/$defs/course" }
    }
  },
  "$defs": {
    "semester": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "shortName", "startDate", "totalWeeks", "periods", "defaultReminderMinutes"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "shortName": { "type": "string", "minLength": 1 },
        "startDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "totalWeeks": { "type": "integer", "minimum": 1, "maximum": 30 },
        "defaultReminderMinutes": { "type": "integer", "minimum": 0, "maximum": 180 },
        "periods": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/period" }
        }
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "start", "end"],
      "properties": {
        "index": { "type": "integer", "minimum": 1 },
        "start": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
        "end": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" }
      }
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "teacher", "location", "department", "note", "colorID", "kind", "weeks", "meetings"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "teacher": { "type": "string" },
        "location": { "type": "string" },
        "department": { "type": "string" },
        "note": { "type": "string" },
        "colorID": { "type": "string" },
        "kind": { "type": "string" },
        "weeks": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1 },
        "meetings": { "type": "array", "items": { "$ref": "#/$defs/meeting" }, "minItems": 1 },
        "reminderLeadMinutes": { "type": "integer", "minimum": 0, "maximum": 180 }
      }
    },
    "meeting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "weekday", "startPeriod", "endPeriod"],
      "properties": {
        "id": { "type": "string" },
        "weekday": { "type": "integer", "minimum": 1, "maximum": 7 },
        "startPeriod": { "type": "integer", "minimum": 1 },
        "endPeriod": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
